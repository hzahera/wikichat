# Copy this file to .env and fill in what you need. Every line is optional except WIKICHAT_WIKI_URL.
# Secrets (logins, keys, passwords) are best kept OUT of this file: use `wikichat login`,
# `wikichat set-key` and `wikichat set-password`, which save them in the system keychain.

# ---------------------------------------------------------------- Wiki
# Any page of your MediaWiki
WIKICHAT_WIKI_URL=https://wikis.uni-paderborn.de/dice/Hauptseite
# Leave empty to auto-discover. Set it if `wikichat check` cannot find the API.
WIKICHAT_WIKI_API_URL=
# Leave empty to use the links the wiki returns. {title} is replaced with the page title.
WIKICHAT_WIKI_PAGE_URL=

# Only on servers or in Docker, where no keychain exists:
# WIKICHAT_WIKI_USERNAME=yourname@wikichat
# WIKICHAT_WIKI_PASSWORD=
# WIKICHAT_WIKI_COOKIE=

# Namespaces to crawl: 0 = main pages, 4 = project, 14 = categories
WIKICHAT_NAMESPACES=0
WIKICHAT_REQUEST_DELAY=0.3

# ------------------------------------------------------------- Privacy
# Hide passwords, PINs, keys and tokens found in wiki text before indexing
WIKICHAT_REDACT_SECRETS=true
# Never download or index these pages
# WIKICHAT_EXCLUDE_TITLES=^(Passwords|Admin/.*)$
# WIKICHAT_EXCLUDE_CATEGORIES=Vertraulich,Intern

# --------------------------------------------------------------- Search
WIKICHAT_TOP_K=6
# Semantic search (needs: pip install -e ".[embeddings]")
WIKICHAT_USE_EMBEDDINGS=false

# ------------------------------------------------------------------ LLM
# none = search only, openai = any OpenAI-compatible API, anthropic = Claude API
WIKICHAT_LLM_PROVIDER=none

# Local model with Ollama (nothing leaves your machine)
# WIKICHAT_LLM_PROVIDER=openai
# WIKICHAT_LLM_BASE_URL=http://localhost:11434/v1
# WIKICHAT_LLM_MODEL=llama3.1

# OpenAI (API key: run `wikichat set-key`)
# WIKICHAT_LLM_PROVIDER=openai
# WIKICHAT_LLM_BASE_URL=https://api.openai.com/v1
# WIKICHAT_LLM_MODEL=gpt-4o-mini

# Model on a GPU server: see "Run the model on a server or VM" in the README
# WIKICHAT_LLM_BASE_URL=http://<gpu-server>:8001/v1
# Turn off "thinking" (Ollama: {"think": false}, vLLM + Qwen: {"chat_template_kwargs": {"enable_thinking": false}})
# WIKICHAT_LLM_EXTRA_BODY={"think": false}

# Anthropic (API key: run `wikichat set-key`)
# WIKICHAT_LLM_PROVIDER=anthropic
# WIKICHAT_LLM_MODEL=claude-haiku-5-5

# --------------------------------------------------------------- Server
# 127.0.0.1 = only this computer. Any other address needs a password (`wikichat set-password`).
WIKICHAT_HOST=127.0.0.1
WIKICHAT_PORT=8000
WIKICHAT_RATE_LIMIT_PER_MINUTE=20
# Only if a reverse proxy in front already asks for a login:
# WIKICHAT_ALLOW_OPEN=true

# ------------------------------------------------------------- Branding
WIKICHAT_BOT_NAME=DICE Wiki Assistant
WIKICHAT_ORG_NAME=DICE
WIKICHAT_ORG_URL=https://dice-research.org
# Put your logo in branding/ (.svg, .png, .jpg or .webp)
# WIKICHAT_ORG_LOGO_FILE=branding/org-logo.svg
WIKICHAT_ACCENT_COLOR=#14b8a6
WIKICHAT_WELCOME_TITLE=Hi, what would you like to know?
WIKICHAT_WELCOME_TEXT=I search every page of the DICE wiki and answer with links to the sources.
# Example questions on the start screen, separated by |
WIKICHAT_SUGGESTIONS=How do I get access to the GPU servers?|Wie beantrage ich eine Dienstreise?|What should new members do in their first week?|Where can I find the paper templates?
